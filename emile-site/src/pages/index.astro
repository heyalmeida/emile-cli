---
import Base from '~/layouts/Base.astro';
import Station from '~/components/Station.astro';
import BaudotEncoder from '~/components/BaudotEncoder.astro';
---
<Base active="home">
  <!-- ─── HERO ─────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-telegraph px-6 pt-16 sm:pt-24 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-12 items-end">
      <div>
        <div class="text-ink-muted uppercase tracking-signal text-[0.6875rem] mb-6 flex items-center gap-3">
          <span class="inline-block w-2 h-2 bg-copper"></span>
          <span>terminal · agent · open-source</span>
        </div>
        <h1 class="font-display text-5xl sm:text-7xl leading-[0.95] tracking-tight text-ink">
          A pair programmer<br/>
          <span class="text-copper">that lives in</span><br/>
          the terminal.
        </h1>
        <p class="mt-8 text-lg text-ink-soft max-w-prose leading-relaxed">
          emile reads your files, writes your code, and runs your commands — without
          leaving your shell. Connect any OpenAI-compatible model, watch it think in
          real time, approve every shell action, and undo anything you don't like.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/install" class="btn btn--copper">
            <span>install</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://github.com/mc33p/emile-cli" class="btn" rel="noopener">
            <span>source</span>
            <span aria-hidden="true">↗</span>
          </a>
          <span class="text-ink-muted text-xs ml-2 uppercase tracking-signal">node 18+ · mit</span>
        </div>
      </div>

      <!-- Hero "ticker tape": the product's tagline as incoming frames -->
      <aside class="border border-ink-line bg-paper-warm p-6 font-mono text-sm">
        <div class="ticker mb-4">
          <span>live · wire</span>
          <span class="text-ink-muted">ch · 01</span>
        </div>
        <div class="space-y-1.5">
          <div class="flex gap-3"><span class="text-copper">◼◼◻◻◼</span><span class="text-ink-muted text-xs">11000</span><span class="text-ink">A</span></div>
          <div class="flex gap-3"><span class="text-copper">◼◻◻◻◼</span><span class="text-ink-muted text-xs">10000</span><span class="text-ink">E</span></div>
          <div class="flex gap-3"><span class="text-copper">◼◼◼◻◼</span><span class="text-ink-muted text-xs">11110</span><span class="text-ink">K</span></div>
          <div class="flex gap-3"><span class="text-copper">◼◻◼◼◼</span><span class="text-ink-muted text-xs">10111</span><span class="text-ink">X</span></div>
          <div class="flex gap-3"><span class="text-copper">◼◻◼◻◻</span><span class="text-ink-muted text-xs">10100</span><span class="text-ink">S</span></div>
          <div class="flex gap-3"><span class="text-copper">◼◻◻◼◻</span><span class="text-ink-muted text-xs">10001</span><span class="text-ink">Z</span></div>
          <div class="flex gap-3 text-copper-deep text-xs"><span class="tracking-signal">··</span><span class="text-ink-muted">shift</span><span>LTRS</span></div>
        </div>
        <p class="mt-4 text-xs text-ink-muted leading-relaxed">
          One wire. One frame at a time. Five bits decide everything —<br/>
          which is, incidentally, also how your prompt reaches the model.
        </p>
      </aside>
    </div>
  </section>

  <hr />

  <!-- ─── 01 · SIGNAL ────────────────────────────────────────────── -->
  <Station index="01" label="the signal" caption="what you get">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <article class="card">
        <div class="text-copper uppercase tracking-signal text-[0.6875rem] mb-3">⏵ provider · agnostic</div>
        <h3 class="font-display text-xl text-ink mb-3">Bring your own model.</h3>
        <p class="text-sm text-ink-soft leading-relaxed">
          Talk to Requesty, OpenRouter, OpenCode, or any OpenAI-compatible
          endpoint. No vendor lock-in. Switch models mid-session with
          <code class="text-copper">/model</code>.
        </p>
      </article>
      <article class="card">
        <div class="text-copper uppercase tracking-signal text-[0.6875rem] mb-3">⏵ safe · by · default</div>
        <h3 class="font-display text-xl text-ink mb-3">Nothing runs without you.</h3>
        <p class="text-sm text-ink-soft leading-relaxed">
          Safe mode blocks destructive commands. <code class="text-copper">/undo</code>
          rewinds file changes. <code class="text-copper">--dry-run</code> simulates the
          whole job. You stay in control of your machine.
        </p>
      </article>
      <article class="card">
        <div class="text-copper uppercase tracking-signal text-[0.6875rem] mb-3">⏵ cost · transparent</div>
        <h3 class="font-display text-xl text-ink mb-3">Pay for what you ask.</h3>
        <p class="text-sm text-ink-soft leading-relaxed">
          Real token usage, not vibes. Live context in the status bar. Prompt
          caching cuts repeats. Dial reasoning effort from
          <code class="text-copper">low</code> to <code class="text-copper">max</code>.
        </p>
      </article>
    </div>
  </Station>

  <!-- ─── 02 · TRANSMISSION ──────────────────────────────────────── -->
  <Station index="02" label="transmission" caption="how it works">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <div>
        <ol class="space-y-6 font-mono">
          <li class="grid grid-cols-[3rem_1fr] gap-4">
            <span class="text-copper text-right">01</span>
            <div>
              <div class="text-ink uppercase tracking-signal text-[0.6875rem]">encode</div>
              <p class="text-ink-soft mt-1">Your prompt becomes a sequence of tokens the model can decode.</p>
            </div>
          </li>
          <li class="grid grid-cols-[3rem_1fr] gap-4">
            <span class="text-copper text-right">02</span>
            <div>
              <div class="text-ink uppercase tracking-signal text-[0.6875rem]">stream · think</div>
              <p class="text-ink-soft mt-1">Watch the model reason live. Collapsed by default. Toggle any time.</p>
            </div>
          </li>
          <li class="grid grid-cols-[3rem_1fr] gap-4">
            <span class="text-copper text-right">03</span>
            <div>
              <div class="text-ink uppercase tracking-signal text-[0.6875rem]">execute · tools</div>
              <p class="text-ink-soft mt-1">Read, write, edit, search, run. Each tool is gated, logged, undoable.</p>
            </div>
          </li>
          <li class="grid grid-cols-[3rem_1fr] gap-4">
            <span class="text-copper text-right">04</span>
            <div>
              <div class="text-ink uppercase tracking-signal text-[0.6875rem]">acknowledge</div>
              <p class="text-ink-soft mt-1">Result returns. Context updates. Loop continues until the model stops asking.</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="border border-ink-line bg-graphite text-cream p-6 font-mono text-[0.8125rem] leading-relaxed">
        <div class="text-graphite-ghost uppercase tracking-signal text-[0.6875rem] mb-3">$ · emile</div>
<pre class="whitespace-pre-wrap"><span class="text-copper">▸</span> emile "add validation to src/api.js"

<span class="text-graphite-ghost">·· thinking ··</span> <span class="text-graphite-ghost">3s</span>
<span class="text-graphite-ghost">  examining api.js · checking existing schemas</span>

<span class="text-copper">◼ read</span>   src/api.js
<span class="text-copper">◼ grep</span>   schema
<span class="text-copper">◼ write</span>  src/api.js <span class="text-graphite-ghost">+24 −6</span>

<span class="text-cream">added input validation using zod. safe-mode on,
dry-run off. review the diff or /undo to revert.</span>

<span class="text-graphite-ghost">↳ 3 tools · 14,302 tokens · $0.018</span></pre>
      </div>
    </div>
  </Station>

  <!-- ─── 03 · CIRCUIT ──────────────────────────────────────────── -->
  <Station index="03" label="circuit" caption="what it ships with">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">tools</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          Read, write, edit (diff-based), list, find, grep, run shell commands. All gated.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">mcp</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          Connect external tool servers via Model Context Protocol. Namespaced as
          <code class="text-copper">mcp__server__tool</code>.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">skills</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          40+ YAML modules that inject domain expertise (React, TDD, security, …)
          only when relevant.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">plans</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          <code class="text-copper">-p</code> makes the agent draft a plan and wait for your
          approval before any file changes.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">sessions</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          Per-workspace persistence. Resume, switch, export, rewind.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">/undo</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          Multi-level undo for file modifications. <code class="text-copper">/undo 3</code> reverts three steps.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">rules</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          Optional <code class="text-copper">.emilerules</code> for your project's preferences. Inspect the
          active source with <code class="text-copper">/rules</code>.
        </p>
      </div>
      <div>
        <div class="text-copper text-xs uppercase tracking-signal mb-2">zero · deps</div>
        <p class="text-ink-soft text-sm leading-relaxed">
          No native modules. No build step. Pure ES modules, one tree, runs anywhere Node 18 does.
        </p>
      </div>
    </div>
  </Station>

  <!-- ─── 04 · PULSE ────────────────────────────────────────────── -->
  <Station index="04" label="pulse" caption="try the encoding">
    <BaudotEncoder />
    <p class="mt-6 text-ink-muted text-sm max-w-prose">
      Every character above is encoded in the same 5-bit code that Émile Baudot
      standardized in 1874. The bits your keystroke produces are the bits your
      prompt produces — different wire, same idea.
    </p>
  </Station>

  <!-- ─── 05 · CREDIT ────────────────────────────────────────────── -->
  <Station index="05" label="credit" caption="the namesake">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-10">
      <div>
        <p class="font-display text-3xl leading-tight text-ink">
          Émile Baudot<br/>
          <span class="text-ink-muted">1845 — 1903</span>
        </p>
        <p class="mt-3 text-ink-muted text-xs uppercase tracking-signal">french · telegraph · engineer</p>
      </div>
      <div class="prose prose-sm max-w-prose text-ink-soft">
        <p>
          Baudot was a self-taught French telegraph operator who invented the
          5-bit code that became the ancestor of every digital encoding that
          followed. His multiplexed telegraph let several messages share one
          wire — the same trade-off modern agents make when several tools share
          one context window.
        </p>
        <p>
          The unit of transmission speed — the <em>baud</em> — is named for him.
          emile is named for him because every prompt is, at the lowest level,
          still a sequence of pulses on a wire.
        </p>
      </div>
    </div>
  </Station>

  <!-- ─── CTA ───────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-telegraph px-6 pb-24">
    <div class="border border-ink-line bg-paper-warm p-8 sm:p-12 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-8 items-end">
      <div>
        <h2 class="font-display text-4xl sm:text-5xl tracking-tight leading-[0.95]">
          Stop switching tools.<br/>
          <span class="text-copper">Send the signal.</span>
        </h2>
        <p class="mt-4 text-ink-soft max-w-prose">
          Three commands and you're coding with the model of your choice — in
          the terminal you already have.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/install" class="btn btn--copper justify-between">
          <span>install emile</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="https://github.com/mc33p/emile-cli" class="btn justify-between" rel="noopener">
          <span>read the source</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>
