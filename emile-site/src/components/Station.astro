---
interface Props {
  index: string; // e.g. "01"
  label: string; // e.g. "signal"
  caption?: string; // optional subline
}

const { index, label, caption } = Astro.props;
---
<section class="mx-auto max-w-telegraph px-6 py-20">
  <header class="mb-10 flex items-center gap-3 station">
    <span class="station__dot" aria-hidden="true"></span>
    <span class="station__index">{index}</span>
    <span class="text-ink">{label}</span>
    {caption && <span class="text-ink-muted">· {caption}</span>}
  </header>
  <slot />
</section>
